# Copy to dashboard/.env on the Mac mini. Never commit .env — this repo is public.
# Placeholder values only.

PORT=4173

# iCloud CalDAV. Use an app-specific password from appleid.apple.com,
# not the Apple ID password. Leave both blank to serve the mock calendar.
ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=Calendário da Família

# Open-Meteo location. Fahrenheit, US units. Defaults to Chicago.
LAT=41.8781
LON=-87.6298

# Optional folder of jpg/png/webp/gif images for the photo tile and screensaver.
# Leave blank for the built-in placeholders.
PHOTOS_DIR=
