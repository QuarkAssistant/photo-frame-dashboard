# Copy to dashboard/.env on the Mac mini. Never commit .env — this repo is public.
# Placeholder values only.

PORT=4173

# iCloud CalDAV. Use an app-specific password from appleid.apple.com,
# not the Apple ID password. Leave both blank to serve the mock calendar.
ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=Calendário da Família

# Open-Meteo location. Defaults to Naperville. The board shows °F and °C.
LAT=41.7859
LON=-88.1473
WEATHER_PLACE=Naperville

# Shared Apple Reminders list. Match is a prefix, so "Supermercado" finds
# "Supermercado ⚠️". macOS only; other systems keep data/store.json.
REMINDERS_GROCERY_LIST=Supermercado

# Dim clock in America/Chicago. 23:00 through 06:00; a tap wakes the board for 2 minutes.
NIGHT_START=23:00
NIGHT_END=06:00

# Optional folder of jpg/png/webp/gif images for the photo tile and screensaver.
# Leave blank to show the family emblem.
PHOTOS_DIR=

# SenseCraft HMI indoor sensor on the Home weather card.
# Replace both placeholders. Leave either one blank to hide the line.
# The key stays in .env only. Never commit it, and never log it.
SENSECRAFT_DEVICE_ID=your-device-id
SENSECRAFT_API_KEY=your-api-key

# Find My: optional preferred device per person (name exactly as in Find My's Devices tab).
# Used when its fix is no older than FINDMY_DEVICE_MAX_AGE_MIN; otherwise the People-tab location.
# FINDMY_DEVICE=kid=Kid's Apple Watch
# FINDMY_DEVICE_MAX_AGE_MIN=30
