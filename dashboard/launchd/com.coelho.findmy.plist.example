<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.coelho.findmy</string>
  <key>ProgramArguments</key><array><string>/path/to/dashboard/server/bin/findmy-people</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/coelho-findmy.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/coelho-findmy.log</string>
</dict>
</plist>
