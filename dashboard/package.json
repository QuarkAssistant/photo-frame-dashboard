{
  "name": "home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/index.js",
    "test": "REMINDERS_FAKE=1 node --test --test-force-exit --test-timeout=20000 server/*.test.js",
    "reminders:build": "mkdir -p server/bin && swiftc -O -o server/bin/reminders-grocery server/reminders.swift",
    "deploy": "vite build && wrangler deploy",
    "findmy:build": "mkdir -p server/bin && swiftc -O -o server/bin/findmy-people server/findmy.swift"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "wrangler": "^4.145.0"
  }
}
